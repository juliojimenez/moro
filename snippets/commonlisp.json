{
  "defun": {
    "prefix": "defun",
    "body": ["(defun ${1:name} (${2:args})", "  \"${3:Docstring.}\"", "  $0)"],
    "description": "Define a function"
  },
  "defmacro": {
    "prefix": "defmacro",
    "body": ["(defmacro ${1:name} (${2:args} &body body)", "  \"${3:Docstring.}\"", "  `(progn", "     ,@body$0))"],
    "description": "Define a macro"
  },
  "defvar": {
    "prefix": "defvar",
    "body": ["(defvar *${1:name}* ${2:nil}", "  \"${3:Docstring.}\")"],
    "description": "Define a special variable"
  },
  "defparameter": {
    "prefix": "defparameter",
    "body": ["(defparameter *${1:name}* ${2:nil}", "  \"${3:Docstring.}\")"],
    "description": "Define a special variable that is always re-initialized"
  },
  "defconstant": {
    "prefix": "defconstant",
    "body": ["(defconstant +${1:name}+ ${2:value}", "  \"${3:Docstring.}\")"],
    "description": "Define a constant"
  },
  "defclass": {
    "prefix": "defclass",
    "body": [
      "(defclass ${1:name} (${2:superclasses})",
      "  ((${3:slot} :initarg :${3:slot}",
      "    :initform ${4:nil}",
      "    :accessor ${1:name}-${3:slot}))",
      "  (:documentation \"${5:Docstring.}\"))"
    ],
    "description": "Define a class"
  },
  "defstruct": {
    "prefix": "defstruct",
    "body": ["(defstruct ${1:name}", "  ${2:slot})"],
    "description": "Define a structure"
  },
  "defgeneric": {
    "prefix": "defgeneric",
    "body": ["(defgeneric ${1:name} (${2:args})", "  (:documentation \"${3:Docstring.}\"))"],
    "description": "Define a generic function"
  },
  "defmethod": {
    "prefix": "defmethod",
    "body": ["(defmethod ${1:name} ((${2:object} ${3:class}))", "  $0)"],
    "description": "Define a method"
  },
  "define-condition": {
    "prefix": "define-condition",
    "body": [
      "(define-condition ${1:name} (${2:error})",
      "  ((${3:slot} :initarg :${3:slot} :reader ${1:name}-${3:slot}))",
      "  (:report (lambda (condition stream)",
      "             (format stream \"${4:~A}\" (${1:name}-${3:slot} condition)))))"
    ],
    "description": "Define a condition type"
  },
  "defpackage": {
    "prefix": "defpackage",
    "body": [
      "(defpackage #:${1:name}",
      "  (:use #:cl)",
      "  (:export #:${2:symbol}))",
      "",
      "(in-package #:${1:name})",
      "$0"
    ],
    "description": "Define a package and switch to it"
  },
  "in-package": {
    "prefix": "in-package",
    "body": ["(in-package #:${1:name})"],
    "description": "Switch the current package"
  },
  "defsystem": {
    "prefix": "defsystem",
    "body": [
      "(defsystem \"${1:name}\"",
      "  :description \"${2:Description}\"",
      "  :author \"${3:Author}\"",
      "  :license \"${4:MIT}\"",
      "  :version \"${5:0.1.0}\"",
      "  :depends-on (${6})",
      "  :components ((:file \"${7:package}\")",
      "               (:file \"${8:main}\"))",
      "  :in-order-to ((test-op (test-op \"${1:name}/tests\"))))"
    ],
    "description": "ASDF system definition"
  },
  "let": {
    "prefix": "let",
    "body": ["(let ((${1:var} ${2:value}))", "  $0)"],
    "description": "Bind variables in parallel"
  },
  "let*": {
    "prefix": "let*",
    "body": ["(let* ((${1:var} ${2:value}))", "  $0)"],
    "description": "Bind variables sequentially"
  },
  "lambda": {
    "prefix": "lambda",
    "body": ["(lambda (${1:args}) $0)"],
    "description": "Anonymous function"
  },
  "flet": {
    "prefix": "flet",
    "body": ["(flet ((${1:name} (${2:args})", "         $3))", "  $0)"],
    "description": "Local functions"
  },
  "labels": {
    "prefix": "labels",
    "body": ["(labels ((${1:name} (${2:args})", "           $3))", "  $0)"],
    "description": "Local recursive functions"
  },
  "if": {
    "prefix": "if",
    "body": ["(if ${1:test}", "    ${2:then}", "    ${3:else})"],
    "description": "Conditional"
  },
  "when": {
    "prefix": "when",
    "body": ["(when ${1:test}", "  $0)"],
    "description": "Conditional with body"
  },
  "unless": {
    "prefix": "unless",
    "body": ["(unless ${1:test}", "  $0)"],
    "description": "Negative conditional with body"
  },
  "cond": {
    "prefix": "cond",
    "body": ["(cond (${1:test} ${2:result})", "      (t ${3:default}))"],
    "description": "Multi-branch conditional"
  },
  "case": {
    "prefix": "case",
    "body": ["(case ${1:key}", "  (${2:value} ${3:result})", "  (otherwise ${4:default}))"],
    "description": "Dispatch on EQL keys"
  },
  "typecase": {
    "prefix": "typecase",
    "body": ["(typecase ${1:object}", "  (${2:type} ${3:result})", "  (t ${4:default}))"],
    "description": "Dispatch on type"
  },
  "loop-for": {
    "prefix": "loop",
    "body": ["(loop for ${1:x} in ${2:list}", "      ${3:collect} $0)"],
    "description": "Extended LOOP over a list"
  },
  "dolist": {
    "prefix": "dolist",
    "body": ["(dolist (${1:x} ${2:list})", "  $0)"],
    "description": "Iterate over a list"
  },
  "dotimes": {
    "prefix": "dotimes",
    "body": ["(dotimes (${1:i} ${2:count})", "  $0)"],
    "description": "Iterate a number of times"
  },
  "multiple-value-bind": {
    "prefix": "multiple-value-bind",
    "body": ["(multiple-value-bind (${1:values}) ${2:form}", "  $0)"],
    "description": "Bind multiple values"
  },
  "destructuring-bind": {
    "prefix": "destructuring-bind",
    "body": ["(destructuring-bind (${1:pattern}) ${2:form}", "  $0)"],
    "description": "Destructure a list"
  },
  "handler-case": {
    "prefix": "handler-case",
    "body": ["(handler-case ${1:form}", "  (${2:error} (${3:e})", "    $0))"],
    "description": "Handle conditions"
  },
  "handler-bind": {
    "prefix": "handler-bind",
    "body": ["(handler-bind ((${1:error} (lambda (${2:e}) $3)))", "  $0)"],
    "description": "Bind condition handlers"
  },
  "unwind-protect": {
    "prefix": "unwind-protect",
    "body": ["(unwind-protect", "    ${1:protected-form}", "  ${2:cleanup-form})"],
    "description": "Run cleanup forms on exit"
  },
  "with-open-file": {
    "prefix": "with-open-file",
    "body": ["(with-open-file (${1:stream} ${2:pathname} :direction :${3:input})", "  $0)"],
    "description": "Open a file for the body"
  },
  "with-output-to-string": {
    "prefix": "with-output-to-string",
    "body": ["(with-output-to-string (${1:stream})", "  $0)"],
    "description": "Collect output into a string"
  },
  "with-slots": {
    "prefix": "with-slots",
    "body": ["(with-slots (${1:slots}) ${2:instance}", "  $0)"],
    "description": "Access slots as variables"
  },
  "format": {
    "prefix": "format",
    "body": ["(format ${1:t} \"${2:~A~%}\" ${3:args})"],
    "description": "Formatted output"
  },
  "declare-type": {
    "prefix": "declare",
    "body": ["(declare (type ${1:fixnum} ${2:var}))"],
    "description": "Type declaration"
  },
  "optimize": {
    "prefix": "optimize",
    "body": ["(declaim (optimize (speed ${1:3}) (safety ${2:1}) (debug ${3:0})))"],
    "description": "Global optimization settings"
  },
  "eval-when": {
    "prefix": "eval-when",
    "body": ["(eval-when (:compile-toplevel :load-toplevel :execute)", "  $0)"],
    "description": "Control evaluation time"
  }
}
